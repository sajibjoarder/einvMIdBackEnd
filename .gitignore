############################################################
#  .NET / Visual Studio – standard gitignore (API-only)    #
#  Same as: dotnet new gitignore  (SDK ≥ 2.0)              #
############################################################

######## IDE-specific ########
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.sln.iml                # Rider
*.userprefs              # Xamarin / MonoDevelop
*.tss                    # Tabs Studio
*.code-workspace

######## Build output ########
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
TestResults/
[Dd]ebug*/               # Debug, DebugPublic
[Rr]elease*/             # Release
x64/
x86/
*.coverage*
*.trx
*.dll
*.exe
*.pdb
*.cache
*.dbmdl
*.tmp
*.pidb
*.binlog

######## .NET Core & tooling ########
project.lock.json
project.fragment.lock.json
project.assets.json
*.deps.json
*.runtimeconfig.json
.ScaffoldingReadMe.txt
BenchmarkDotNet.Artifacts/

######## Configuration & secrets ########
appsettings.Development.json
launchSettings.json      # machine-specific URLs & ports
secrets.json

######## NuGet ########
*.nupkg
*.snupkg
*.symbols.nupkg
packages/
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

######## Entity Framework migrations (optional) ########
# Migrations/

######## Publish output ########
publish/
out/

######## SQL / backups / reports ########
*.bak
*.sql
*.mdf
*.ldf
*.ndf
*.rptproj.*
*.rdl.data

######## Miscellaneous ########
.DS_Store
Thumbs.db
*.dmp
~$*
*~
